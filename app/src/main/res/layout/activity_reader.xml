<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Navigation & Search Bar -->
    <LinearLayout
        android:id="@+id/top_toolbar"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#004b91"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <Button
            android:id="@+id/btn_back_library"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:text="&#8592;"
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:background="#003566"
            android:padding="0dp" />

        <EditText
            android:id="@+id/edit_search"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:hint="@string/search_hint"
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:textColorHint="#b0c4de"
            android:background="#003566"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_home"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:text="&#8962;"
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:background="#003566"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Progress indicator -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <!-- Main WebView content -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffffff" />

    <!-- Bottom Action Bar (Thumb-friendly above BB10 Keyboard) -->
    <LinearLayout
        android:id="@+id/bottom_toolbar"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#1a1a1a"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <Button
            android:id="@+id/btn_random"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Random"
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:background="#2d2d2d"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_night"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Night"
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:background="#2d2d2d"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_zoom"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="100%"
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:background="#2d2d2d"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_bookmark"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="&#9733; Save"
            android:textSize="12sp"
            android:textColor="#ffb703"
            android:background="#2d2d2d"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_bookmarks_list"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="List"
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:background="#2d2d2d"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_share"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Wi-Fi"
            android:textSize="12sp"
            android:textColor="#00b4d8"
            android:background="#2d2d2d"
            android:padding="0dp" />
    </LinearLayout>

</LinearLayout>
